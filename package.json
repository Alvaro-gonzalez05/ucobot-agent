{
  "name": "ucobot-agent",
  "version": "1.1.0",
  "description": "Puente entre UcoBot y el hardware del local: impresión directa sin diálogo, gaveta de dinero y lo que venga.",
  "main": "src/index.js",
  "bin": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "build": "pkg . --targets node22-win-x64 --output dist/UcoBotAgent.exe --compress GZip"
  },
  "pkg": {
    "assets": [
      "package.json"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^5.16.1"
  },
  "license": "UNLICENSED",
  "private": true
}
